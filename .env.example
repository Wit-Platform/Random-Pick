# ─────────────────────────────────────────────────────────────
# 카카오맵 (developers.kakao.com)
# ─────────────────────────────────────────────────────────────

# JavaScript 키 — 지도 타일 렌더링용. 브라우저에 노출되는 것이 정상이며
# 카카오 콘솔의 [플랫폼 > Web > 사이트 도메인] 등록으로 보호됩니다.
#   등록 필요: http://localhost:3000
#             https://<your-project>.vercel.app
# 비워두면 절차적 캔버스 지도로 폴백합니다 (키 없이도 게임 플레이 가능).
NEXT_PUBLIC_KAKAO_JS_KEY=

# REST API 키 — 실제 식당 검색용. 서버에서만 사용합니다.
# 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요. 도메인 제한이 없어 유출되면 그대로 도용됩니다.
# 비워두면 좌표 시드 기반 샘플 식당 데이터로 폴백합니다.
KAKAO_REST_KEY=

# ─────────────────────────────────────────────────────────────
# Upstash Redis (선택) — POI 캐시 + rate limit + 그룹 플레이
#
# Vercel 대시보드 > Storage > Upstash Redis 연결 시 자동 주입됩니다.
# 통합 버전에 따라 KV_REST_API_URL / KV_REST_API_TOKEN 이름으로 올 수도 있는데,
# 코드가 양쪽 다 받으므로 손댈 필요 없습니다.
#
# 리전은 Vercel 함수 리전(icn1, 서울)에 가까운 곳을 고르세요. 요청마다 Redis를
# 왕복하므로 us-east를 고르면 모든 API 호출에 300ms 이상이 붙습니다.
# → ap-northeast-1 (도쿄) 권장
#
# 비워두면 프로세스 메모리로 동작합니다. 서버리스에서는 인스턴스마다 메모리가
# 달라 캐시·rate limit이 사실상 무력해지고 그룹 기능은 숨겨집니다.
# ─────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─────────────────────────────────────────────────────────────
# 검색·공유 (선택)
# ─────────────────────────────────────────────────────────────

# canonical URL과 OG 태그의 기준 주소. 커스텀 도메인이 생기면 여기만 바꾸면 됩니다.
# 미설정 시 https://random-pick-blush.vercel.app
NEXT_PUBLIC_SITE_URL=

# Google Search Console에서 발급받는 소유 확인 값 (content 속성만)
GOOGLE_SITE_VERIFICATION=

# 네이버 서치어드바이저 소유 확인 값
NAVER_SITE_VERIFICATION=

# ─────────────────────────────────────────────────────────────
# 쿼터 보호 (선택)
# ─────────────────────────────────────────────────────────────

# 하루에 허용할 카카오 로컬 API 호출 수. 이 예산을 넘으면 실패시키지 않고
# 샘플 데이터로 내려앉습니다. 콘솔에서 실제 쿼터를 확인한 뒤 보수적으로 잡으세요.
# 미설정 시 8000.
KAKAO_DAILY_BUDGET=

# 로컬 검증 전용. Upstash 없이 메모리 스토어로 그룹 기능을 켭니다.
# 서버리스에서는 인스턴스마다 메모리가 달라 동기화가 깨지므로
# 프로덕션에서는 절대 켜지 마세요. (NODE_ENV=production이면 무시됩니다)
ALLOW_MEMORY_GROUP=
